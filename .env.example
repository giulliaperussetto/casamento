# Conexão PostgreSQL (Supabase: Project Settings → Database → Connection string, modo "Transaction pooler" porta 6543)
DATABASE_URL=postgres://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# Segredo usado para gerar o hash dos códigos de convite (HMAC). Gere com: openssl rand -base64 48
# NUNCA altere depois de criar convites — os códigos existentes deixariam de ser reconhecidos.
INVITE_CODE_PEPPER=

# Chave de 32 bytes (base64) para criptografar os códigos e exibi-los no painel. Gere com: openssl rand -base64 32
INVITE_CODE_ENCRYPTION_KEY=

# Segredo para hash de IPs nos limites de requisição. Gere com: openssl rand -base64 32
RATE_LIMIT_SECRET=

# Defina como "true" em desenvolvimento local sem HTTPS (cookies sem flag Secure)
INSECURE_COOKIES=false

# URL pública do site (usada nas imagens de compartilhamento)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br
